# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env

# API Key YouTube Data API v3 (wajib untuk fitur crawling & analisis video)
# Ambil di: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Kunci session Flask (opsional, ganti dengan string acak saat deploy)
SECRET_KEY=ganti-dengan-string-acak

# 1 untuk mode debug, 0 untuk produksi (default)
FLASK_DEBUG=0

# ------------------------------------------------------------------ Telegram (opsional)
# Sumber data: pesan channel publik Telegram.
# 1) Dapatkan api_id & api_hash GRATIS: https://my.telegram.org (login via HP
#    -> "API development tools" -> isi nama app -> Create application)
# 2) Jalankan SEKALI:  python setup_telegram.py  (login via kode Telegram)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ------------------------------------------------------------------ Instagram (opsional)
# Sumber data: post & komentar publik (hashtag/profil) via Instaloader.
# PERHATIAN: wilayah abu-abu (bukan API resmi) - Instagram bisa membatasi akses.
# Disarankan memakai AKUN KEDUA (bukan akun utama). Kosongkan untuk akses anonim
# (sering dibatasi, terutama untuk hashtag).
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ------------------------------------------------------------------ Jaringan
# Batas waktu satu request ke API (detik). Naikkan kalau internet lambat.
HTTP_TIMEOUT=60
# Jumlah percobaan ulang saat koneksi gagal (WinError 10060 dsb).
NET_RETRIES=3
# Jika memakai proxy kantor/kampus, isi salah satu:
# HTTPS_PROXY=http://proxy.kantor:8080
# HTTP_PROXY=http://proxy.kantor:8080
